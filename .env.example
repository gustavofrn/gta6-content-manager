# Banco de dados
# Desenvolvimento: SQLite (padrão)
DATABASE_URL="file:./dev.db"
# Produção: PostgreSQL (descomente e configure)
# DATABASE_URL="postgresql://user:password@localhost:5432/gta6_manager?schema=public"

# Auth.js (NextAuth)
# Gere com: openssl rand -base64 32
AUTH_SECRET="coloque-um-segredo-aqui"
AUTH_URL="http://localhost:3000"

# Credenciais do administrador inicial (usadas no seed; configure antes de semear)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Agente de IA (opcional). Sem chave, o sistema usa o gerador local determinístico.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# Publicação via webhook (opcional). Sem URL, a publicação é registrada manualmente.
PUBLISH_WEBHOOK_URL=""

# Aprovação pelo Telegram (opcional). Configure um bot e webhook HTTPS antes de preencher.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
TELEGRAM_WEBHOOK_SECRET=""

# Variáveis para armazenamento externo (deixe em branco por enquanto)
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
